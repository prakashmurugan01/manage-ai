DJANGO_SECRET_KEY=local-dev-change-before-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_ENGINE=mysql
DB_NAME=manageai
DB_USER=manageai
DB_PASSWORD=manageai
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_INIT_COMMAND=SET sql_mode='STRICT_TRANS_TABLES'

USE_INMEMORY_CHANNELS=True
REDIS_URL=redis://127.0.0.1:6379/0

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
MANAGEAI_SEED_PASSWORD=ManageAI@12345
AI_PROVIDER=local
GITHUB_TOKEN=
